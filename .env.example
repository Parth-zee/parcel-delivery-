# Copy this file to `.env` (or set the same variables in your hosting
# dashboard) and change what you need. Every value here is optional.
# Values starting with VITE_ are bundled into the public JavaScript, so never
# put a secret key in a VITE_ variable.

# ---------------------------------------------------------------- Map tiles
# Default: the standard OpenStreetMap tile server (free, no key, light use only;
# see https://operations.osmfoundation.org/policies/tiles/).
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
VITE_TILE_MAX_ZOOM=19

# ---------------------------------------------------------------- Location
# Set to "off" to build a version with no GPS, map or routing (for hosts that
# block location access). Default: on.
# VITE_LOCATION=off

# ---------------------------------------------------------------- Routing
# osrm  -> calls an OSRM server directly from the browser (no key needed).
#          Default server is the public OSRM demo (car profile, fair-use only).
# proxy -> calls your own backend endpoint, which holds the secret key.
#          A ready-made Netlify Function for OpenRouteService is included at
#          netlify/functions/route.mts (endpoint: /api/route).
# none  -> no route, no distance, no ETA.
VITE_ROUTING_PROVIDER=osrm
VITE_OSRM_URL=https://router.project-osrm.org
VITE_OSRM_PROFILE=driving
VITE_ROUTING_PROXY_URL=/api/route

# ------------------------------------------------- Server-side only (proxy)
# Set these in the Netlify dashboard (Site configuration -> Environment
# variables), NOT with a VITE_ prefix. They never reach the browser.
# ORS_API_KEY=your-openrouteservice-key
# ORS_PROFILE=driving-car
